# =====================================================================
# Retail Operating System — required configuration
#
# Every variable below is validated at startup (see
# apps/api/src/common/config/validate-environment.ts). A process missing
# a required one refuses to boot rather than failing on the first login.
#
# Copy to `.env`, fill in real values, and never commit the result.
# =====================================================================

NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------
# DATABASE — TWO CONNECTIONS, AND THE DIFFERENCE MATTERS
#
# DATABASE_URL is the OWNER connection. It runs migrations and the seed,
# and it BYPASSES every row-level security policy in the schema. The API
# must never use it.
#
# RUNTIME_DATABASE_URL is the restricted `erp_app` role: NOSUPERUSER,
# NOBYPASSRLS, and granted exactly the privileges each table needs -
# SELECT and INSERT only on every append-only ledger. This is what the
# API connects as, and it is what makes tenant isolation a property of
# the database rather than a promise made by application code.
#
# In production the two must differ; startup refuses if they match.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_dev?schema=public
RUNTIME_DATABASE_URL=postgresql://erp_app:CHANGE_ME@localhost:5432/erp_dev?schema=public

# ---------------------------------------------------------------------
# AUTHENTICATION
#
# Two DIFFERENT secrets, each at least 32 characters. Signing both token
# types with one key means a refresh token is a valid access token.
# Generate with:  openssl rand -base64 48
#
# Changing either secret invalidates every token signed with it, which is
# the intended lever for a suspected compromise.
# ---------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------
# HTTP
#
# CORS_ORIGIN is a comma-separated allow-list. Unset means NO browser
# origin is permitted - safe, and usually an oversight in production.
# ---------------------------------------------------------------------
CORS_ORIGIN=

# ---------------------------------------------------------------------
# OPENAPI
#
# The browsable contract at /api/v1/docs. On automatically outside
# production; in production it stays off unless this is exactly "true",
# because an unauthenticated map of every endpoint helps an attacker more
# than it helps a client.
# ---------------------------------------------------------------------
SWAGGER_ENABLED=false

# ---------------------------------------------------------------------
# RATE LIMITING
#
# Per IP, per minute, held in memory per process. Endpoints that are
# actually attacked carry these tighter limits; everything behind a token
# keeps the global ceiling, because a valid session plus a permission
# check plus an audit row are already stronger controls than a counter.
#
# Leave unset to use the defaults shown. Raise the login budget only if a
# deployment sits behind a shared NAT.
# ---------------------------------------------------------------------
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTRATION=5
RATE_LIMIT_CREDENTIAL=20

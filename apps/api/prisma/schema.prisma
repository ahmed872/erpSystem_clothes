// Phase 1 (Foundation) + Phase 2 (Products & Catalog) schema.
// Inventory/Accounting/Sales/Purchasing entities are intentionally NOT
// modeled yet — they arrive in later phases per docs/architecture.
// Multi-tenancy: shared schema + tenant_id + PostgreSQL Row-Level Security.
// RLS policies are added via raw SQL in migration
// 20260828120000_enable_row_level_security (Prisma cannot express RLS).
// Phase 2 adds its own RLS migration (20260828140500_catalog_rls) following
// the exact same pattern.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PERMISSION_DENIED
}

/// Tenant root. Every tenant-scoped table carries businessId ("tenant_id")
/// and is protected by a Postgres RLS policy comparing it to
/// current_setting('app.current_tenant_id').
model Business {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  currency  String         @default("EGP")
  timezone  String         @default("Africa/Cairo")
  status    BusinessStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  branches   Branch[]
  warehouses Warehouse[]
  users      User[]
  roles      Role[]
  settings   Setting[]
  auditLogs  AuditLog[]

  categories      Category[]
  brands          Brand[]
  uoms            Uom[]
  attributes      ProductAttribute[]
  attributeValues ProductAttributeValue[]
  products        Product[]
  variants        ProductVariant[]
  productUoms     ProductUom[]
  barcodes        Barcode[]
  priceLists      PriceList[]
  productPrices   ProductPrice[]
  priceHistory    ProductPriceHistory[]

  stockMovements StockMovement[]
  stockBalances  StockBalance[]
  inventoryLots  InventoryLot[]
  serialNumbers  SerialNumber[]
  stockCounts    StockCount[]
  stockTransfers StockTransfer[]

  @@map("businesses")
}

model Branch {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  address    String?
  phone      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouses     Warehouse[]
  userBranches   UserBranch[]
  stockMovements StockMovement[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("branches")
}

model Warehouse {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  branchId   String   @map("branch_id")
  name       String
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "warehouses_business_fk")
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  stockMovements StockMovement[]
  stockBalances  StockBalance[]
  stockCounts    StockCount[]
  transfersOut   StockTransfer[] @relation("TransferSource")
  transfersIn    StockTransfer[] @relation("TransferDestination")
  serialNumbers  SerialNumber[]

  @@unique([branchId, name])
  @@index([businessId])
  @@index([branchId])
  @@map("warehouses")
}

model User {
  id           String     @id @default(uuid())
  businessId   String     @map("business_id")
  name         String
  email        String
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String?    @map("created_by")
  updatedBy    String?    @map("updated_by")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "users_business_fk")
  userRoles     UserRole[]
  userBranches  UserBranch[]
  refreshTokens RefreshToken[]

  @@unique([businessId, email])
  @@index([businessId])
  @@map("users")
}

/// Scopes a user to specific branches. Empty = access to all branches
/// (subject to permission checks); used by branch-level data isolation
/// in later phases (sales, inventory, cash).
model UserBranch {
  userId   String @map("user_id")
  branchId String @map("branch_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model Role {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  isSystem   Boolean  @default(false) @map("is_system")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "roles_business_fk")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("roles")
}

/// Global catalog of permission codes — NOT tenant-scoped (see §9 Roles &
/// Permissions in Phase 0 doc). Seeded once at deploy time.
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Refresh tokens are stored hashed and are individually revocable
/// (logout / rotation), unlike short-lived access tokens which are
/// stateless JWTs validated by signature + expiry only.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Key/value business settings (currency display, invoice numbering, RTL,
/// negative-inventory toggle, etc. — expanded in later phases). Kept
/// generic in Phase 1 rather than one column per setting.
model Setting {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  key        String
  value      Json
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "settings_business_fk")

  @@unique([businessId, key])
  @@index([businessId])
  @@map("settings")
}

/// Append-only. Application code must never UPDATE or DELETE rows here —
/// enforced additionally at the DB role level (see migration 3).
model AuditLog {
  id         String      @id @default(uuid())
  businessId String?     @map("business_id")
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  requestId  String?     @map("request_id")
  createdAt  DateTime    @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull, map: "audit_business_fk")

  @@index([businessId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// Phase 2: Products & Catalog
//
// Design notes (see docs/architecture/PHASE-0-ARCHITECTURE.md §5-8 and
// docs/state/PROJECT_STATE.md for the full rationale):
//
// - Every sellable/stockable unit is a ProductVariant, never a Product
//   directly. A "simple" product with no configurable attributes still
//   gets exactly one auto-created default ProductVariant at creation time
//   (same SKU as the product), so Inventory (Phase 3) and Sales (Phase 5)
//   only ever need to reference variantId — one uniform join key, no
//   "is this a variant or a plain product" branching anywhere downstream.
// - A Bundle is a Product with type=BUNDLE. It still gets its own default
//   variant (that's what gets sold/scanned), but carries NO inventory of
//   its own — BundleItem lists the component variants consumed when the
//   bundle sells (Phase 3 wires the actual stock consumption once
//   StockMovement exists; the catalog composition is defined now).
// - Money/quantity fields are NUMERIC(18,4) (Decimal in Prisma), matching
//   the Phase 0 rule against FLOAT for anything financial or stock-related.
// ============================================================================

enum ProductType {
  SIMPLE
  BUNDLE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
}

enum PriceChangeType {
  COST
  SELLING_PRICE
  LIST_PRICE
}

model Category {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  parentId    String?  @map("parent_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "categories_business_fk")
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryParent")
  products Product[]

  // Top-level (parentId IS NULL) uniqueness is enforced separately by a
  // partial unique index in migration 20260828140000_catalog_schema,
  // because Postgres treats NULL as distinct in a normal unique
  // constraint (two NULL parentId rows would NOT collide here).
  @@unique([businessId, parentId, name])
  @@index([businessId])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "brands_business_fk")
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("brands")
}

/// Tenant-level catalog of measurement units (Piece, Carton, Kg, ...).
/// `precision` is the number of decimal places a quantity in this unit
/// may carry (0 for "Piece", up to a few for weight-based units) -
/// Inventory (Phase 3) will use this to reject fractional pieces while
/// allowing fractional kilograms.
model Uom {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  code       String
  precision  Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "uoms_business_fk")
  baseForProducts Product[]       @relation("ProductBaseUom")
  productUoms     ProductUom[]
  stockMovements  StockMovement[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@index([businessId])
  @@map("uoms")
}

/// Dynamic/configurable attribute TYPE (e.g. "Color", "Size") - the actual
/// choices live in ProductAttributeValue. Both are tenant-scoped so every
/// business defines its own attribute vocabulary rather than the system
/// hardcoding clothing-specific concepts (Phase 0 §2/§58).
model ProductAttribute {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "attributes_business_fk")
  values   ProductAttributeValue[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  attributeId String   @map("attribute_id")
  value       String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  business  Business                @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "attribute_values_business_fk")
  attribute ProductAttribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  VariantAttributeValue[]

  @@unique([attributeId, value])
  // Composite-FK target for VariantAttributeValue: lets the database
  // itself guarantee that a variant's chosen value actually belongs to
  // the attribute it's recorded against (see VariantAttributeValue).
  @@unique([id, attributeId])
  @@index([businessId])
  @@map("product_attribute_values")
}

model Product {
  id                  String        @id @default(uuid())
  businessId          String        @map("business_id")
  sku                 String
  name                String
  alternativeName     String?       @map("alternative_name")
  categoryId          String?       @map("category_id")
  brandId             String?       @map("brand_id")
  description         String?
  type                ProductType   @default(SIMPLE)
  status              ProductStatus @default(ACTIVE)
  defaultCost         Decimal       @default(0) @map("default_cost") @db.Decimal(18, 4)
  defaultSellingPrice Decimal       @default(0) @map("default_selling_price") @db.Decimal(18, 4)
  minimumStock        Decimal?      @map("minimum_stock") @db.Decimal(18, 4)
  maximumStock        Decimal?      @map("maximum_stock") @db.Decimal(18, 4)
  baseUomId           String        @map("base_uom_id")
  images              Json?
  // Phase 3 additions (Inventory Engine): whether variants of this product
  // require lot/expiry or serial-number tracking on every stock movement.
  // Purely additive config the Inventory Engine reads - does not change
  // any Phase 1/2 behavior.
  tracksLots          Boolean       @default(false) @map("tracks_lots")
  tracksSerialNumbers Boolean       @default(false) @map("tracks_serial_numbers")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  createdBy           String?       @map("created_by")
  updatedBy           String?       @map("updated_by")

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "products_business_fk")
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand       Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseUom     Uom              @relation("ProductBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  productUoms ProductUom[]
  bundleItems BundleItem[]     @relation("BundleProduct")

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id           String               @id @default(uuid())
  businessId   String               @map("business_id")
  productId    String               @map("product_id")
  sku          String
  status       ProductVariantStatus @default(ACTIVE)
  cost         Decimal              @default(0) @db.Decimal(18, 4)
  sellingPrice Decimal              @default(0) @map("selling_price") @db.Decimal(18, 4)
  weight       Decimal?             @db.Decimal(18, 4)
  dimensions   Json?
  images       Json?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  createdBy    String?              @map("created_by")
  updatedBy    String?              @map("updated_by")

  business           Business                @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "variants_business_fk")
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues    VariantAttributeValue[]
  barcodes           Barcode[]
  productPrices      ProductPrice[]
  priceHistory       ProductPriceHistory[]
  bundleComponentOf  BundleItem[]            @relation("BundleComponent")
  stockMovements     StockMovement[]
  stockBalances      StockBalance[]
  inventoryLots      InventoryLot[]
  serialNumbers      SerialNumber[]
  stockCountItems    StockCountItem[]
  stockTransferItems StockTransferItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

/// Join row recording one attribute=value choice for a variant (e.g.
/// Color=Black). `attributeId` is denormalized from attributeValueId
/// purely so the composite FK below can force the database to reject a
/// value that doesn't actually belong to the given attribute, and so
/// @@id([variantId, attributeId]) can guarantee a variant never carries
/// two different values for the same attribute (can't be both
/// Color=Black and Color=White).
model VariantAttributeValue {
  variantId        String @map("variant_id")
  attributeId      String @map("attribute_id")
  attributeValueId String @map("attribute_value_id")

  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId, attributeId], references: [id, attributeId], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

/// A non-base unit a product can be purchased and/or sold in, with its
/// conversion factor back to the product's base UOM (Phase 0 §7 - e.g.
/// "1 Carton = 12 Pieces" where Piece is the base). The base UOM itself
/// is never duplicated here (factor 1 is implicit) - see Product.baseUomId.
model ProductUom {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  productId        String   @map("product_id")
  uomId            String   @map("uom_id")
  conversionFactor Decimal  @map("conversion_factor") @db.Decimal(18, 6)
  isPurchaseUom    Boolean  @default(false) @map("is_purchase_uom")
  isSalesUom       Boolean  @default(false) @map("is_sales_uom")
  createdAt        DateTime @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "product_uoms_business_fk")
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom      Uom       @relation(fields: [uomId], references: [id], onDelete: Restrict)
  barcodes Barcode[]

  @@unique([productId, uomId])
  @@index([businessId])
  @@map("product_uoms")
}

/// A variant may have several barcodes (different pack levels via
/// productUomId, regional codes, legacy codes...). `productUomId` null
/// means the barcode identifies the variant at its base UOM.
model Barcode {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  variantId    String   @map("variant_id")
  productUomId String?  @map("product_uom_id")
  code         String
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "barcodes_business_fk")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productUom ProductUom?    @relation(fields: [productUomId], references: [id], onDelete: SetNull)

  // At most one isPrimary=true per variant is enforced by a partial
  // unique index in migration 20260828140000_catalog_schema (Prisma has
  // no way to express a partial index in the schema DSL).
  @@unique([businessId, code])
  @@index([variantId])
  @@map("barcodes")
}

/// A named pricing tier (Retail, Wholesale, VIP...). Exactly one
/// isDefault=true list per tenant, enforced by a partial unique index
/// (see migration 20260828140000_catalog_schema).
model PriceList {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "price_lists_business_fk")
  prices   ProductPrice[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("price_lists")
}

model ProductPrice {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  priceListId String   @map("price_list_id")
  variantId   String   @map("variant_id")
  price       Decimal  @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "product_prices_business_fk")
  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId])
  @@index([businessId])
  @@index([variantId])
  @@map("product_prices")
}

/// Append-only ledger of cost/price changes - immutable at the DB
/// privilege level too (SELECT+INSERT only for erp_app), same pattern as
/// AuditLog. This is what Phase 7's "Price History" report reads from,
/// and it's what keeps a promise distinct from AuditLog's generic
/// before/after snapshots: a dedicated, queryable domain ledger.
model ProductPriceHistory {
  id          String          @id @default(uuid())
  businessId  String          @map("business_id")
  variantId   String          @map("variant_id")
  priceListId String?         @map("price_list_id")
  changeType  PriceChangeType @map("change_type")
  oldValue    Decimal?        @map("old_value") @db.Decimal(18, 4)
  newValue    Decimal         @map("new_value") @db.Decimal(18, 4)
  changedBy   String?         @map("changed_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "price_history_business_fk")
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([variantId])
  @@map("product_price_history")
}

/// Composition of a Bundle-type Product. componentVariantId must belong
/// to a SIMPLE product (enforced in application logic, not DB - no
/// nested bundles in Phase 2, see PROJECT_STATE.md Known Issues).
model BundleItem {
  id                 String   @id @default(uuid())
  bundleProductId    String   @map("bundle_product_id")
  componentVariantId String   @map("component_variant_id")
  quantity           Decimal  @db.Decimal(18, 4)
  createdAt          DateTime @default(now()) @map("created_at")

  bundleProduct    Product        @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation("BundleComponent", fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@unique([bundleProductId, componentVariantId])
  @@index([componentVariantId])
  @@map("bundle_items")
}

// ============================================================================
// Phase 3: Inventory Engine
//
// SOURCE OF TRUTH: StockMovement (below) is the ONLY source of truth for
// inventory quantities and cost. Nothing anywhere reads a denormalized
// "Product.quantity" counter - none exists. StockBalance is a derived
// cache of `SUM(quantityBase) GROUP BY (business, warehouse, variant)`,
// updated transactionally alongside every StockMovement insert purely as
// a read-performance cache, and independently recomputable/verifiable
// from the ledger at any time (see InventoryReconciliationService in
// application code, and GET /inventory/reconciliation).
//
// CONCURRENCY: every write to a (warehouse, variant) pair takes a
// `SELECT ... FOR UPDATE` row lock on its StockBalance row inside the
// same DB transaction as the StockMovement insert (see
// engines/inventory/inventory-engine.service.ts). Two concurrent
// requests touching the same (warehouse, variant) serialize on that
// lock - the second one sees the first one's committed balance before
// it decides whether there's enough stock, which is what makes
// oversell-prevention actually work under real concurrency rather than
// just in a single-threaded test.
//
// COSTING: Weighted Average Cost. Every StockMovement stores
// unit_cost_at_movement - for an increase, the cost the stock arrived
// at; for a decrease, the average cost in effect at that exact moment
// (locked in as that movement's COGS forever). Changing today's average
// cost never rewrites a past movement's unit_cost_at_movement, so
// historical COGS never drifts (Phase 0 §10).
// ============================================================================

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  STOCK_COUNT
  ADJUSTMENT
  DAMAGE
  LOSS
  INTERNAL_CONSUMPTION
  EXPIRY
  BUNDLE_CONSUMPTION
  AUTHORIZED_CORRECTION
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CANCELLED
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SerialNumberStatus {
  IN_STOCK
  RESERVED
  SOLD
  DAMAGED
  RETURNED
}

/// Append-only. Never UPDATEd or DELETEd by application code - enforced
/// additionally at the DB grant level (erp_app has SELECT+INSERT only,
/// same treatment as AuditLog / ProductPriceHistory). A correction to a
/// past movement is always a NEW movement (movementType
/// AUTHORIZED_CORRECTION) referencing the one it corrects via
/// referenceType/referenceId, never an edit in place.
model StockMovement {
  id                 String            @id @default(uuid())
  businessId         String            @map("business_id")
  branchId           String            @map("branch_id")
  warehouseId        String            @map("warehouse_id")
  variantId          String            @map("variant_id")
  movementType       StockMovementType @map("movement_type")
  /// Signed, always in the variant's base UOM. Positive = stock in,
  /// negative = stock out. StockBalance.quantityOnHand = SUM of this.
  quantityBase       Decimal           @map("quantity_base") @db.Decimal(18, 4)
  /// The UOM/quantity as originally entered (e.g. "2 Cartons"), kept for
  /// traceability only - quantityBase is always what balances are
  /// computed from (Phase 0 §7: inventory is tracked internally in base
  /// UOM regardless of the transaction UOM).
  uomId              String?           @map("uom_id")
  quantityInUom      Decimal?          @map("quantity_in_uom") @db.Decimal(18, 4)
  /// Per-base-unit cost basis for this specific movement (see costing
  /// note above) - never recomputed retroactively.
  unitCostAtMovement Decimal           @map("unit_cost_at_movement") @db.Decimal(18, 4)
  referenceType      String?           @map("reference_type")
  referenceId        String?           @map("reference_id")
  lotId              String?           @map("lot_id")
  isNegativeStock    Boolean           @default(false) @map("is_negative_stock")
  reason             String?
  createdBy          String?           @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "stock_movements_business_fk")
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  uom       Uom?           @relation(fields: [uomId], references: [id], onDelete: SetNull)
  // Restrict, not SetNull: a lot referenced by a historical movement must
  // never lose that reference just because someone deleted the lot
  // record - the ledger's traceability would silently degrade. In
  // practice this is moot too: erp_app has no DELETE grant on
  // inventory_lots at all (see migration
  // 20260828131700_inventory_app_role_grants), so this is defense in
  // depth, not the only guard.
  lot       InventoryLot?  @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([warehouseId, variantId])
  @@index([variantId])
  @@index([referenceType, referenceId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_movements")
}

/// Derived cache ONLY - see the module comment above. Never written to
/// directly except by InventoryEngine inside the same transaction as the
/// StockMovement it summarizes, and always re-derivable via
/// `SUM(quantity_base)` from stock_movements.
model StockBalance {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  warehouseId      String   @map("warehouse_id")
  variantId        String   @map("variant_id")
  quantityOnHand   Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  /// Reserved for held/unconfirmed sales (Phase 5 POS "hold invoice").
  /// Column exists now so the schema doesn't need reshaping later;
  /// nothing writes a non-zero value yet in Phase 3.
  quantityReserved Decimal  @default(0) @map("quantity_reserved") @db.Decimal(18, 4)
  averageCost      Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  updatedAt        DateTime @updatedAt @map("updated_at")

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "stock_balances_business_fk")
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([businessId, warehouseId, variantId])
  @@index([businessId])
  @@index([variantId])
  @@map("stock_balances")
}

/// Registry of lot/batch metadata only - NOT a quantity counter. "How
/// much of lot X remains" is always `SUM(quantity_base) WHERE lot_id = X`
/// against stock_movements, computed on demand, for exactly the same
/// reason StockBalance itself is a cache and not a second source of
/// truth.
model InventoryLot {
  id                String    @id @default(uuid())
  businessId        String    @map("business_id")
  variantId         String    @map("variant_id")
  lotNumber         String    @map("lot_number")
  manufacturingDate DateTime? @map("manufacturing_date")
  expiryDate        DateTime? @map("expiry_date")
  createdAt         DateTime  @default(now()) @map("created_at")

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "inventory_lots_business_fk")
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([businessId, variantId, lotNumber])
  @@index([businessId])
  @@index([expiryDate])
  @@map("inventory_lots")
}

/// One row per physically serialized unit. currentWarehouseId is a
/// convenience pointer maintained alongside the movement that changes
/// it (receipt sets it, sale/transfer updates it) - the authoritative
/// history of where a serial has been is still the StockMovement rows
/// referencing it via referenceType='SerialNumber'/referenceId.
model SerialNumber {
  id                 String             @id @default(uuid())
  businessId         String             @map("business_id")
  variantId          String             @map("variant_id")
  serial             String
  status             SerialNumberStatus @default(IN_STOCK)
  currentWarehouseId String?            @map("current_warehouse_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "serial_numbers_business_fk")
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currentWarehouse Warehouse?     @relation(fields: [currentWarehouseId], references: [id], onDelete: SetNull)

  @@unique([businessId, serial])
  @@index([businessId])
  @@index([variantId])
  @@index([status])
  @@map("serial_numbers")
}

model StockCount {
  id          String           @id @default(uuid())
  businessId  String           @map("business_id")
  warehouseId String           @map("warehouse_id")
  status      StockCountStatus @default(DRAFT)
  createdBy   String?          @map("created_by")
  submittedAt DateTime?        @map("submitted_at")
  approvedBy  String?          @map("approved_by")
  approvedAt  DateTime?        @map("approved_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "stock_counts_business_fk")
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     StockCountItem[]

  @@index([businessId])
  @@index([warehouseId])
  @@map("stock_counts")
}

model StockCountItem {
  id               String   @id @default(uuid())
  stockCountId     String   @map("stock_count_id")
  variantId        String   @map("variant_id")
  /// Snapshot at count creation, shown to the counter for reference only.
  /// The adjustment actually applied on approval is computed against the
  /// LIVE (locked) balance at approval time, not this snapshot, so sales
  /// that happen during counting are never silently overwritten (see
  /// ApproveStockCountUseCase).
  expectedQuantity Decimal  @map("expected_quantity") @db.Decimal(18, 4)
  actualQuantity   Decimal? @map("actual_quantity") @db.Decimal(18, 4)
  reason           String?

  stockCount StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, variantId])
  @@map("stock_count_items")
}

model StockTransfer {
  id                     String              @id @default(uuid())
  businessId             String              @map("business_id")
  sourceWarehouseId      String              @map("source_warehouse_id")
  destinationWarehouseId String              @map("destination_warehouse_id")
  status                 StockTransferStatus @default(DRAFT)
  createdBy              String?             @map("created_by")
  sentBy                 String?             @map("sent_by")
  sentAt                 DateTime?           @map("sent_at")
  receivedBy             String?             @map("received_by")
  receivedAt             DateTime?           @map("received_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "stock_transfers_business_fk")
  sourceWarehouse      Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse           @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  items                StockTransferItem[]

  @@index([businessId])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String   @id @default(uuid())
  stockTransferId  String   @map("stock_transfer_id")
  variantId        String   @map("variant_id")
  /// Planned/sent quantity, fixed once the transfer is sent.
  quantity         Decimal  @db.Decimal(18, 4)
  /// Filled in on receive; may differ from `quantity` (shrinkage/damage
  /// in transit) - the difference is what the receive action reports,
  /// not auto-corrected.
  quantityReceived Decimal? @map("quantity_received") @db.Decimal(18, 4)

  stockTransfer StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([stockTransferId, variantId])
  @@map("stock_transfer_items")
}

// Phase 1 (Foundation) + Phase 2 (Products & Catalog) schema.
// Inventory/Accounting/Sales/Purchasing entities are intentionally NOT
// modeled yet — they arrive in later phases per docs/architecture.
// Multi-tenancy: shared schema + tenant_id + PostgreSQL Row-Level Security.
// RLS policies are added via raw SQL in migration
// 20260828120000_enable_row_level_security (Prisma cannot express RLS).
// Phase 2 adds its own RLS migration (20260828140500_catalog_rls) following
// the exact same pattern.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PERMISSION_DENIED
}

/// Tenant root. Every tenant-scoped table carries businessId ("tenant_id")
/// and is protected by a Postgres RLS policy comparing it to
/// current_setting('app.current_tenant_id').
model Business {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  currency  String         @default("EGP")
  timezone  String         @default("Africa/Cairo")
  status    BusinessStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  branches   Branch[]
  warehouses Warehouse[]
  users      User[]
  roles      Role[]
  settings   Setting[]
  auditLogs  AuditLog[]

  categories      Category[]
  brands          Brand[]
  uoms            Uom[]
  attributes      ProductAttribute[]
  attributeValues ProductAttributeValue[]
  products        Product[]
  variants        ProductVariant[]
  productUoms     ProductUom[]
  barcodes        Barcode[]
  priceLists      PriceList[]
  productPrices   ProductPrice[]
  priceHistory    ProductPriceHistory[]

  stockMovements StockMovement[]
  stockBalances  StockBalance[]
  inventoryLots  InventoryLot[]
  serialNumbers  SerialNumber[]
  stockCounts    StockCount[]
  stockTransfers StockTransfer[]

  suppliers            Supplier[]
  supplierTransactions SupplierTransaction[]
  purchases            Purchase[]
  purchaseItems        PurchaseItem[]
  purchaseReceipts     PurchaseReceipt[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturns      PurchaseReturn[]
  purchaseReturnItems  PurchaseReturnItem[]
  purchasePayments     PurchasePayment[]

  customers            Customer[]
  customerTransactions CustomerTransaction[]
  shifts               Shift[]
  sales                Sale[]
  saleItems            SaleItem[]
  salePayments         SalePayment[]
  saleReturns          SaleReturn[]
  saleReturnItems      SaleReturnItem[]

  accounts               Account[]
  fiscalPeriods          FiscalPeriod[]
  accountingMappingRules AccountingMappingRule[]
  journalEntries         JournalEntry[]
  journalEntryLines      JournalEntryLine[]

  warranties     Warranty[]
  warrantyClaims WarrantyClaim[]
  customerPoints CustomerPoints[]

  @@map("businesses")
}

model Branch {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  address    String?
  phone      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouses     Warehouse[]
  userBranches   UserBranch[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  shifts         Shift[]
  sales          Sale[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("branches")
}

model Warehouse {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  branchId   String   @map("branch_id")
  name       String
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "warehouses_business_fk")
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  stockMovements StockMovement[]
  stockBalances  StockBalance[]
  stockCounts    StockCount[]
  transfersOut   StockTransfer[] @relation("TransferSource")
  transfersIn    StockTransfer[] @relation("TransferDestination")
  serialNumbers  SerialNumber[]

  purchases        Purchase[]
  purchaseReceipts PurchaseReceipt[]
  purchaseReturns  PurchaseReturn[]

  shifts      Shift[]
  sales       Sale[]
  saleReturns SaleReturn[]

  @@unique([branchId, name])
  @@index([businessId])
  @@index([branchId])
  @@map("warehouses")
}

model User {
  id           String     @id @default(uuid())
  businessId   String     @map("business_id")
  name         String
  email        String
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String?    @map("created_by")
  updatedBy    String?    @map("updated_by")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "users_business_fk")
  userRoles     UserRole[]
  userBranches  UserBranch[]
  refreshTokens RefreshToken[]

  @@unique([businessId, email])
  @@index([businessId])
  @@map("users")
}

/// Scopes a user to specific branches. Empty = access to all branches
/// (subject to permission checks); used by branch-level data isolation
/// in later phases (sales, inventory, cash).
model UserBranch {
  userId   String @map("user_id")
  branchId String @map("branch_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model Role {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  isSystem   Boolean  @default(false) @map("is_system")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "roles_business_fk")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("roles")
}

/// Global catalog of permission codes — NOT tenant-scoped (see §9 Roles &
/// Permissions in Phase 0 doc). Seeded once at deploy time.
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Refresh tokens are stored hashed and are individually revocable
/// (logout / rotation), unlike short-lived access tokens which are
/// stateless JWTs validated by signature + expiry only.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Key/value business settings (currency display, invoice numbering, RTL,
/// negative-inventory toggle, etc. — expanded in later phases). Kept
/// generic in Phase 1 rather than one column per setting.
model Setting {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  key        String
  value      Json
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "settings_business_fk")

  @@unique([businessId, key])
  @@index([businessId])
  @@map("settings")
}

/// Append-only. Application code must never UPDATE or DELETE rows here —
/// enforced additionally at the DB role level (see migration 3).
model AuditLog {
  id         String      @id @default(uuid())
  businessId String?     @map("business_id")
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  requestId  String?     @map("request_id")
  createdAt  DateTime    @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull, map: "audit_business_fk")

  @@index([businessId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// Phase 2: Products & Catalog
//
// Design notes (see docs/architecture/PHASE-0-ARCHITECTURE.md §5-8 and
// docs/state/PROJECT_STATE.md for the full rationale):
//
// - Every sellable/stockable unit is a ProductVariant, never a Product
//   directly. A "simple" product with no configurable attributes still
//   gets exactly one auto-created default ProductVariant at creation time
//   (same SKU as the product), so Inventory (Phase 3) and Sales (Phase 5)
//   only ever need to reference variantId — one uniform join key, no
//   "is this a variant or a plain product" branching anywhere downstream.
// - A Bundle is a Product with type=BUNDLE. It still gets its own default
//   variant (that's what gets sold/scanned), but carries NO inventory of
//   its own — BundleItem lists the component variants consumed when the
//   bundle sells (Phase 3 wires the actual stock consumption once
//   StockMovement exists; the catalog composition is defined now).
// - Money/quantity fields are NUMERIC(18,4) (Decimal in Prisma), matching
//   the Phase 0 rule against FLOAT for anything financial or stock-related.
// ============================================================================

enum ProductType {
  SIMPLE
  BUNDLE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
}

enum PriceChangeType {
  COST
  SELLING_PRICE
  LIST_PRICE
}

model Category {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  parentId    String?  @map("parent_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "categories_business_fk")
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryParent")
  products Product[]

  // Top-level (parentId IS NULL) uniqueness is enforced separately by a
  // partial unique index in migration 20260828140000_catalog_schema,
  // because Postgres treats NULL as distinct in a normal unique
  // constraint (two NULL parentId rows would NOT collide here).
  @@unique([businessId, parentId, name])
  @@index([businessId])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "brands_business_fk")
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("brands")
}

/// Tenant-level catalog of measurement units (Piece, Carton, Kg, ...).
/// `precision` is the number of decimal places a quantity in this unit
/// may carry (0 for "Piece", up to a few for weight-based units) -
/// Inventory (Phase 3) will use this to reject fractional pieces while
/// allowing fractional kilograms.
model Uom {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  code       String
  precision  Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "uoms_business_fk")
  baseForProducts Product[]       @relation("ProductBaseUom")
  productUoms     ProductUom[]
  stockMovements  StockMovement[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@index([businessId])
  @@map("uoms")
}

/// Dynamic/configurable attribute TYPE (e.g. "Color", "Size") - the actual
/// choices live in ProductAttributeValue. Both are tenant-scoped so every
/// business defines its own attribute vocabulary rather than the system
/// hardcoding clothing-specific concepts (Phase 0 §2/§58).
model ProductAttribute {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "attributes_business_fk")
  values   ProductAttributeValue[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  attributeId String   @map("attribute_id")
  value       String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  business  Business                @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "attribute_values_business_fk")
  attribute ProductAttribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  VariantAttributeValue[]

  @@unique([attributeId, value])
  // Composite-FK target for VariantAttributeValue: lets the database
  // itself guarantee that a variant's chosen value actually belongs to
  // the attribute it's recorded against (see VariantAttributeValue).
  @@unique([id, attributeId])
  @@index([businessId])
  @@map("product_attribute_values")
}

model Product {
  id                  String        @id @default(uuid())
  businessId          String        @map("business_id")
  sku                 String
  name                String
  alternativeName     String?       @map("alternative_name")
  categoryId          String?       @map("category_id")
  brandId             String?       @map("brand_id")
  description         String?
  type                ProductType   @default(SIMPLE)
  status              ProductStatus @default(ACTIVE)
  defaultCost         Decimal       @default(0) @map("default_cost") @db.Decimal(18, 4)
  defaultSellingPrice Decimal       @default(0) @map("default_selling_price") @db.Decimal(18, 4)
  minimumStock        Decimal?      @map("minimum_stock") @db.Decimal(18, 4)
  maximumStock        Decimal?      @map("maximum_stock") @db.Decimal(18, 4)
  baseUomId           String        @map("base_uom_id")
  images              Json?
  // Phase 3 additions (Inventory Engine): whether variants of this product
  // require lot/expiry or serial-number tracking on every stock movement.
  // Purely additive config the Inventory Engine reads - does not change
  // any Phase 1/2 behavior.
  tracksLots          Boolean       @default(false) @map("tracks_lots")
  tracksSerialNumbers Boolean       @default(false) @map("tracks_serial_numbers")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  createdBy           String?       @map("created_by")
  updatedBy           String?       @map("updated_by")

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "products_business_fk")
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand       Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseUom     Uom              @relation("ProductBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  productUoms ProductUom[]
  bundleItems BundleItem[]     @relation("BundleProduct")

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id           String               @id @default(uuid())
  businessId   String               @map("business_id")
  productId    String               @map("product_id")
  sku          String
  status       ProductVariantStatus @default(ACTIVE)
  cost         Decimal              @default(0) @db.Decimal(18, 4)
  sellingPrice Decimal              @default(0) @map("selling_price") @db.Decimal(18, 4)
  weight       Decimal?             @db.Decimal(18, 4)
  dimensions   Json?
  images       Json?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  createdBy    String?              @map("created_by")
  updatedBy    String?              @map("updated_by")

  business           Business                @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "variants_business_fk")
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues    VariantAttributeValue[]
  barcodes           Barcode[]
  productPrices      ProductPrice[]
  priceHistory       ProductPriceHistory[]
  bundleComponentOf  BundleItem[]            @relation("BundleComponent")
  stockMovements     StockMovement[]
  stockBalances      StockBalance[]
  inventoryLots      InventoryLot[]
  serialNumbers      SerialNumber[]
  stockCountItems    StockCountItem[]
  stockTransferItems StockTransferItem[]

  purchaseItems        PurchaseItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturnItems  PurchaseReturnItem[]

  saleItems       SaleItem[]
  saleReturnItems SaleReturnItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

/// Join row recording one attribute=value choice for a variant (e.g.
/// Color=Black). `attributeId` is denormalized from attributeValueId
/// purely so the composite FK below can force the database to reject a
/// value that doesn't actually belong to the given attribute, and so
/// @@id([variantId, attributeId]) can guarantee a variant never carries
/// two different values for the same attribute (can't be both
/// Color=Black and Color=White).
model VariantAttributeValue {
  variantId        String @map("variant_id")
  attributeId      String @map("attribute_id")
  attributeValueId String @map("attribute_value_id")

  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue ProductAttributeValue @relation(fields: [attributeValueId, attributeId], references: [id, attributeId], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

/// A non-base unit a product can be purchased and/or sold in, with its
/// conversion factor back to the product's base UOM (Phase 0 §7 - e.g.
/// "1 Carton = 12 Pieces" where Piece is the base). The base UOM itself
/// is never duplicated here (factor 1 is implicit) - see Product.baseUomId.
model ProductUom {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  productId        String   @map("product_id")
  uomId            String   @map("uom_id")
  conversionFactor Decimal  @map("conversion_factor") @db.Decimal(18, 6)
  isPurchaseUom    Boolean  @default(false) @map("is_purchase_uom")
  isSalesUom       Boolean  @default(false) @map("is_sales_uom")
  createdAt        DateTime @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "product_uoms_business_fk")
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom      Uom       @relation(fields: [uomId], references: [id], onDelete: Restrict)
  barcodes Barcode[]

  @@unique([productId, uomId])
  @@index([businessId])
  @@map("product_uoms")
}

/// A variant may have several barcodes (different pack levels via
/// productUomId, regional codes, legacy codes...). `productUomId` null
/// means the barcode identifies the variant at its base UOM.
model Barcode {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  variantId    String   @map("variant_id")
  productUomId String?  @map("product_uom_id")
  code         String
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "barcodes_business_fk")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productUom ProductUom?    @relation(fields: [productUomId], references: [id], onDelete: SetNull)

  // At most one isPrimary=true per variant is enforced by a partial
  // unique index in migration 20260828140000_catalog_schema (Prisma has
  // no way to express a partial index in the schema DSL).
  @@unique([businessId, code])
  @@index([variantId])
  @@map("barcodes")
}

/// A named pricing tier (Retail, Wholesale, VIP...). Exactly one
/// isDefault=true list per tenant, enforced by a partial unique index
/// (see migration 20260828140000_catalog_schema).
model PriceList {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "price_lists_business_fk")
  prices   ProductPrice[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("price_lists")
}

model ProductPrice {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  priceListId String   @map("price_list_id")
  variantId   String   @map("variant_id")
  price       Decimal  @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "product_prices_business_fk")
  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId])
  @@index([businessId])
  @@index([variantId])
  @@map("product_prices")
}

/// Append-only ledger of cost/price changes - immutable at the DB
/// privilege level too (SELECT+INSERT only for erp_app), same pattern as
/// AuditLog. This is what Phase 7's "Price History" report reads from,
/// and it's what keeps a promise distinct from AuditLog's generic
/// before/after snapshots: a dedicated, queryable domain ledger.
model ProductPriceHistory {
  id          String          @id @default(uuid())
  businessId  String          @map("business_id")
  variantId   String          @map("variant_id")
  priceListId String?         @map("price_list_id")
  changeType  PriceChangeType @map("change_type")
  oldValue    Decimal?        @map("old_value") @db.Decimal(18, 4)
  newValue    Decimal         @map("new_value") @db.Decimal(18, 4)
  changedBy   String?         @map("changed_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "price_history_business_fk")
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([variantId])
  @@map("product_price_history")
}

/// Composition of a Bundle-type Product. componentVariantId must belong
/// to a SIMPLE product (enforced in application logic, not DB - no
/// nested bundles in Phase 2, see PROJECT_STATE.md Known Issues).
model BundleItem {
  id                 String   @id @default(uuid())
  bundleProductId    String   @map("bundle_product_id")
  componentVariantId String   @map("component_variant_id")
  quantity           Decimal  @db.Decimal(18, 4)
  createdAt          DateTime @default(now()) @map("created_at")

  bundleProduct    Product        @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentVariant ProductVariant @relation("BundleComponent", fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@unique([bundleProductId, componentVariantId])
  @@index([componentVariantId])
  @@map("bundle_items")
}

// ============================================================================
// Phase 3: Inventory Engine
//
// SOURCE OF TRUTH: StockMovement (below) is the ONLY source of truth for
// inventory quantities and cost. Nothing anywhere reads a denormalized
// "Product.quantity" counter - none exists. StockBalance is a derived
// cache of `SUM(quantityBase) GROUP BY (business, warehouse, variant)`,
// updated transactionally alongside every StockMovement insert purely as
// a read-performance cache, and independently recomputable/verifiable
// from the ledger at any time (see InventoryReconciliationService in
// application code, and GET /inventory/reconciliation).
//
// CONCURRENCY: every write to a (warehouse, variant) pair takes a
// `SELECT ... FOR UPDATE` row lock on its StockBalance row inside the
// same DB transaction as the StockMovement insert (see
// engines/inventory/inventory-engine.service.ts). Two concurrent
// requests touching the same (warehouse, variant) serialize on that
// lock - the second one sees the first one's committed balance before
// it decides whether there's enough stock, which is what makes
// oversell-prevention actually work under real concurrency rather than
// just in a single-threaded test.
//
// COSTING: Weighted Average Cost. Every StockMovement stores
// unit_cost_at_movement - for an increase, the cost the stock arrived
// at; for a decrease, the average cost in effect at that exact moment
// (locked in as that movement's COGS forever). Changing today's average
// cost never rewrites a past movement's unit_cost_at_movement, so
// historical COGS never drifts (Phase 0 §10).
// ============================================================================

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  STOCK_COUNT
  ADJUSTMENT
  DAMAGE
  LOSS
  INTERNAL_CONSUMPTION
  EXPIRY
  BUNDLE_CONSUMPTION
  AUTHORIZED_CORRECTION
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CANCELLED
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum SerialNumberStatus {
  IN_STOCK
  RESERVED
  SOLD
  DAMAGED
  RETURNED
}

/// Append-only. Never UPDATEd or DELETEd by application code - enforced
/// additionally at the DB grant level (erp_app has SELECT+INSERT only,
/// same treatment as AuditLog / ProductPriceHistory). A correction to a
/// past movement is always a NEW movement (movementType
/// AUTHORIZED_CORRECTION) referencing the one it corrects via
/// referenceType/referenceId, never an edit in place.
model StockMovement {
  id                 String            @id @default(uuid())
  businessId         String            @map("business_id")
  branchId           String            @map("branch_id")
  warehouseId        String            @map("warehouse_id")
  variantId          String            @map("variant_id")
  movementType       StockMovementType @map("movement_type")
  /// Signed, always in the variant's base UOM. Positive = stock in,
  /// negative = stock out. StockBalance.quantityOnHand = SUM of this.
  quantityBase       Decimal           @map("quantity_base") @db.Decimal(18, 4)
  /// The UOM/quantity as originally entered (e.g. "2 Cartons"), kept for
  /// traceability only - quantityBase is always what balances are
  /// computed from (Phase 0 §7: inventory is tracked internally in base
  /// UOM regardless of the transaction UOM).
  uomId              String?           @map("uom_id")
  quantityInUom      Decimal?          @map("quantity_in_uom") @db.Decimal(18, 4)
  /// Per-base-unit cost basis for this specific movement (see costing
  /// note above) - never recomputed retroactively.
  unitCostAtMovement Decimal           @map("unit_cost_at_movement") @db.Decimal(18, 4)
  referenceType      String?           @map("reference_type")
  referenceId        String?           @map("reference_id")
  lotId              String?           @map("lot_id")
  isNegativeStock    Boolean           @default(false) @map("is_negative_stock")
  reason             String?
  createdBy          String?           @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "stock_movements_business_fk")
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  uom       Uom?           @relation(fields: [uomId], references: [id], onDelete: SetNull)
  // Restrict, not SetNull: a lot referenced by a historical movement must
  // never lose that reference just because someone deleted the lot
  // record - the ledger's traceability would silently degrade. In
  // practice this is moot too: erp_app has no DELETE grant on
  // inventory_lots at all (see migration
  // 20260828131700_inventory_app_role_grants), so this is defense in
  // depth, not the only guard.
  lot       InventoryLot?  @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([warehouseId, variantId])
  @@index([variantId])
  @@index([referenceType, referenceId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_movements")
}

/// Derived cache ONLY - see the module comment above. Never written to
/// directly except by InventoryEngine inside the same transaction as the
/// StockMovement it summarizes, and always re-derivable via
/// `SUM(quantity_base)` from stock_movements.
model StockBalance {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  warehouseId      String   @map("warehouse_id")
  variantId        String   @map("variant_id")
  quantityOnHand   Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  /// Reserved for held/unconfirmed sales (Phase 5 POS "hold invoice").
  /// Column exists now so the schema doesn't need reshaping later;
  /// nothing writes a non-zero value yet in Phase 3.
  quantityReserved Decimal  @default(0) @map("quantity_reserved") @db.Decimal(18, 4)
  averageCost      Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  updatedAt        DateTime @updatedAt @map("updated_at")

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "stock_balances_business_fk")
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([businessId, warehouseId, variantId])
  @@index([businessId])
  @@index([variantId])
  @@map("stock_balances")
}

/// Registry of lot/batch metadata only - NOT a quantity counter. "How
/// much of lot X remains" is always `SUM(quantity_base) WHERE lot_id = X`
/// against stock_movements, computed on demand, for exactly the same
/// reason StockBalance itself is a cache and not a second source of
/// truth.
model InventoryLot {
  id                String    @id @default(uuid())
  businessId        String    @map("business_id")
  variantId         String    @map("variant_id")
  lotNumber         String    @map("lot_number")
  manufacturingDate DateTime? @map("manufacturing_date")
  expiryDate        DateTime? @map("expiry_date")
  createdAt         DateTime  @default(now()) @map("created_at")

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "inventory_lots_business_fk")
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([businessId, variantId, lotNumber])
  @@index([businessId])
  @@index([expiryDate])
  @@map("inventory_lots")
}

/// One row per physically serialized unit. currentWarehouseId is a
/// convenience pointer maintained alongside the movement that changes
/// it (receipt sets it, sale/transfer updates it) - the authoritative
/// history of where a serial has been is still the StockMovement rows
/// referencing it via referenceType='SerialNumber'/referenceId.
model SerialNumber {
  id                 String             @id @default(uuid())
  businessId         String             @map("business_id")
  variantId          String             @map("variant_id")
  serial             String
  status             SerialNumberStatus @default(IN_STOCK)
  currentWarehouseId String?            @map("current_warehouse_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "serial_numbers_business_fk")
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currentWarehouse Warehouse?     @relation(fields: [currentWarehouseId], references: [id], onDelete: SetNull)
  warranties       Warranty[]

  @@unique([businessId, serial])
  @@index([businessId])
  @@index([variantId])
  @@index([status])
  @@map("serial_numbers")
}

model StockCount {
  id          String           @id @default(uuid())
  businessId  String           @map("business_id")
  warehouseId String           @map("warehouse_id")
  status      StockCountStatus @default(DRAFT)
  createdBy   String?          @map("created_by")
  submittedAt DateTime?        @map("submitted_at")
  approvedBy  String?          @map("approved_by")
  approvedAt  DateTime?        @map("approved_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "stock_counts_business_fk")
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     StockCountItem[]

  @@index([businessId])
  @@index([warehouseId])
  @@map("stock_counts")
}

model StockCountItem {
  id               String   @id @default(uuid())
  stockCountId     String   @map("stock_count_id")
  variantId        String   @map("variant_id")
  /// Snapshot at count creation, shown to the counter for reference only.
  /// The adjustment actually applied on approval is computed against the
  /// LIVE (locked) balance at approval time, not this snapshot, so sales
  /// that happen during counting are never silently overwritten (see
  /// ApproveStockCountUseCase).
  expectedQuantity Decimal  @map("expected_quantity") @db.Decimal(18, 4)
  actualQuantity   Decimal? @map("actual_quantity") @db.Decimal(18, 4)
  reason           String?

  stockCount StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, variantId])
  @@map("stock_count_items")
}

model StockTransfer {
  id                     String              @id @default(uuid())
  businessId             String              @map("business_id")
  sourceWarehouseId      String              @map("source_warehouse_id")
  destinationWarehouseId String              @map("destination_warehouse_id")
  status                 StockTransferStatus @default(DRAFT)
  createdBy              String?             @map("created_by")
  sentBy                 String?             @map("sent_by")
  sentAt                 DateTime?           @map("sent_at")
  receivedBy             String?             @map("received_by")
  receivedAt             DateTime?           @map("received_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "stock_transfers_business_fk")
  sourceWarehouse      Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse           @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  items                StockTransferItem[]

  @@index([businessId])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String   @id @default(uuid())
  stockTransferId  String   @map("stock_transfer_id")
  variantId        String   @map("variant_id")
  /// Planned/sent quantity, fixed once the transfer is sent.
  quantity         Decimal  @db.Decimal(18, 4)
  /// Filled in on receive; may differ from `quantity` (shrinkage/damage
  /// in transit) - the difference is what the receive action reports,
  /// not auto-corrected.
  quantityReceived Decimal? @map("quantity_received") @db.Decimal(18, 4)

  stockTransfer StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([stockTransferId, variantId])
  @@map("stock_transfer_items")
}

// ============================================================================
// PHASE 4: PURCHASING
//
// Purchasing is a CONSUMER of the Inventory Engine, never a parallel
// inventory system. Every inventory-affecting operation here (receiving,
// purchase return) calls InventoryEngineService.applyMovement directly and
// produces a real StockMovement (movementType PURCHASE / PURCHASE_RETURN,
// both already defined on StockMovementType in Phase 3) inside the SAME
// DB transaction as the SupplierTransaction ledger write and the
// PurchaseItem/Purchase status updates. No quantity counter here is ever
// read as inventory truth - StockMovement remains the only source of that.
//
// RESPONSIBILITY SEPARATION (deliberately NOT one "God Service"):
//   - Purchase           : the document (header + approval/cancel lifecycle)
//   - PurchaseItem        : ordered lines + the document-level received/
//                           returned quantity invariant (locked via
//                           SELECT ... FOR UPDATE during receiving/return -
//                           a lock target distinct from, and in addition
//                           to, the Inventory Engine's own StockBalance
//                           lock, because the Engine's lock protects stock
//                           correctness, not the "did this PO line
//                           over-receive" document-level invariant)
//   - PurchaseReceipt(s)  : one row per receiving event; a Purchase can
//                           have many (partial / multiple receiving)
//   - PurchaseReturn(s)   : one row per return event (single-step atomic
//                           action, not a draft/confirm workflow)
//   - PurchasePayment     : records money paid to a supplier against a
//                           Purchase - deliberately NOT wired to any
//                           FinancialAccount/JournalEntry (that belongs to
//                           the Phase 6 Accounting Engine); this is the
//                           clean, additive integration boundary Phase 6
//                           will read from, not a fake accounting system.
//   - Supplier balance is NEVER a stored/directly-editable number - it is
//     SUM(SupplierTransaction.amount) for that supplier, computed on read
//     (SupplierBalanceService), exactly mirroring how StockBalance is a
//     derived cache of StockMovement in Phase 3. SupplierTransaction rows
//     are append-only (SELECT+INSERT only grant for erp_app, no
//     UPDATE/DELETE - see the app-role-grants migration).
//
// APPROVAL vs RECEIVING are deliberately separate steps (a documented
// refinement beyond Phase 0's one-line description), required by this
// phase's explicit partial/multiple-receiving and over-receiving-
// prevention rules: a Purchase is APPROVED first (commits the business to
// the order), then receives happen against it 1..N times until fully
// received. SupplierTransaction(PURCHASE) rows are created at RECEIVING
// time, not at Approval, so the payable increase and the inventory
// increase for the same goods always land in the same transaction.
// ============================================================================

enum PurchaseStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierTransactionType {
  PURCHASE
  PURCHASE_RETURN
  PAYMENT
  OPENING_BALANCE
  ADJUSTMENT
}

enum PurchasePaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model Supplier {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  name             String
  contactPerson    String?  @map("contact_person")
  phone            String?
  email            String?
  address          String?
  taxNumber        String?  @map("tax_number")
  paymentTermsDays Int?     @map("payment_terms_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by")
  updatedBy        String?  @map("updated_by")

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "suppliers_business_fk")
  purchases    Purchase[]
  transactions SupplierTransaction[]
  payments     PurchasePayment[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("suppliers")
}

/// Append-only ledger - the ONLY source of truth for a supplier's
/// balance. Balance = SUM(amount) for that supplier, always computed on
/// read, never a stored/mutable column - the same single-source-of-truth
/// principle as StockMovement -> StockBalance (Phase 3).
/// Sign convention: positive = increases what the business owes the
/// supplier (a PURCHASE receipt, or a positive OPENING_BALANCE); negative
/// = decreases it (a PAYMENT or a PURCHASE_RETURN credit).
model SupplierTransaction {
  id            String                  @id @default(uuid())
  businessId    String                  @map("business_id")
  supplierId    String                  @map("supplier_id")
  type          SupplierTransactionType
  amount        Decimal                 @db.Decimal(18, 4)
  referenceType String?                 @map("reference_type")
  referenceId   String?                 @map("reference_id")
  description   String?
  createdBy     String?                 @map("created_by")
  createdAt     DateTime                @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "supplier_transactions_business_fk")
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([supplierId])
  @@index([referenceType, referenceId])
  @@map("supplier_transactions")
}

model Purchase {
  id             String         @id @default(uuid())
  businessId     String         @map("business_id")
  branchId       String         @map("branch_id")
  warehouseId    String         @map("warehouse_id")
  supplierId     String         @map("supplier_id")
  /// Human-readable document number, derived deterministically from `id`
  /// right after insert (PO-<first 8 hex chars of id>) so it never needs
  /// a shared counter/sequence that would serialize concurrent purchase
  /// creation - no two purchases can ever collide since `id` itself is
  /// guaranteed unique.
  purchaseNumber String         @map("purchase_number")
  status         PurchaseStatus @default(DRAFT)
  orderDate      DateTime       @default(now()) @map("order_date")
  expectedDate   DateTime?      @map("expected_date")
  notes          String?
  subtotal       Decimal        @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(18, 4)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(18, 4)
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(18, 4)
  createdBy      String?        @map("created_by")
  approvedBy     String?        @map("approved_by")
  approvedAt     DateTime?      @map("approved_at")
  cancelledBy    String?        @map("cancelled_by")
  cancelledAt    DateTime?      @map("cancelled_at")
  cancelReason   String?        @map("cancel_reason")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "purchases_business_fk")
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier  Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items     PurchaseItem[]
  receipts  PurchaseReceipt[]
  returns   PurchaseReturn[]
  payments  PurchasePayment[]

  @@unique([businessId, purchaseNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([supplierId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id         String @id @default(uuid())
  businessId String @map("business_id")
  purchaseId String @map("purchase_id")
  variantId  String @map("variant_id")

  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(18, 4)
  /// Cumulative quantity received across ALL receipts for this line.
  /// Maintained transactionally alongside each PurchaseReceiptItem
  /// insert. This is the source of truth for the DOCUMENT-level "how much
  /// of this PO line is still outstanding" invariant (guarded by a
  /// `quantity_received <= quantity_ordered` DB CHECK plus a
  /// SELECT ... FOR UPDATE row lock taken on this row during receiving to
  /// prevent concurrent over-receipt) - it is NOT, and must never become,
  /// a source of inventory truth; that remains StockMovement exclusively.
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(18, 4)
  /// Cumulative quantity returned across ALL purchase returns for this
  /// line, guarded the same way (CHECK quantity_returned <=
  /// quantity_received, same row lock).
  quantityReturned Decimal @default(0) @map("quantity_returned") @db.Decimal(18, 4)
  unitCost         Decimal @map("unit_cost") @db.Decimal(18, 4)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  lineTotal        Decimal @default(0) @map("line_total") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "purchase_items_business_fk")
  purchase     Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant      ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems PurchaseReceiptItem[]
  returnItems  PurchaseReturnItem[]

  @@unique([purchaseId, variantId])
  @@index([businessId])
  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_items")
}

model PurchaseReceipt {
  id             String   @id @default(uuid())
  businessId     String   @map("business_id")
  purchaseId     String   @map("purchase_id")
  warehouseId    String   @map("warehouse_id")
  receiptNumber  String   @map("receipt_number")
  /// Optional client-supplied idempotency key so a retried/duplicated
  /// receiving request (e.g. a flaky network resubmit) cannot double-
  /// apply inventory. NULL never conflicts with another NULL (Postgres
  /// treats multiple NULLs as non-conflicting under a unique index), so
  /// dedup is opt-in per request - same pattern as RefreshToken (Phase 1).
  idempotencyKey String?  @map("idempotency_key")
  notes          String?
  receivedBy     String?  @map("received_by")
  receivedAt     DateTime @default(now()) @map("received_at")
  createdAt      DateTime @default(now()) @map("created_at")

  business  Business              @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "purchase_receipts_business_fk")
  purchase  Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     PurchaseReceiptItem[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([purchaseId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                String   @id @default(uuid())
  businessId        String   @map("business_id")
  purchaseReceiptId String   @map("purchase_receipt_id")
  purchaseItemId    String   @map("purchase_item_id")
  variantId         String   @map("variant_id")
  quantityReceived  Decimal  @map("quantity_received") @db.Decimal(18, 4)
  /// Cost this specific batch was received at, copied from
  /// PurchaseItem.unitCost at the moment of receiving and never
  /// retroactively changed. This exact value is what's passed to
  /// InventoryEngineService.applyMovement as the increase's unit cost,
  /// permanently preserved on the resulting StockMovement's
  /// unitCostAtMovement (Phase 3 costing rule).
  unitCost          Decimal  @map("unit_cost") @db.Decimal(18, 4)
  createdAt         DateTime @default(now()) @map("created_at")

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "purchase_receipt_items_business_fk")
  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseItem    PurchaseItem    @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([purchaseReceiptId, purchaseItemId])
  @@index([purchaseReceiptId])
  @@index([purchaseItemId])
  @@index([businessId])
  @@map("purchase_receipt_items")
}

/// A purchase return is a single-step atomic action (not a draft/confirm
/// workflow, unlike Purchase itself): creating one immediately reverses
/// the inventory impact via InventoryEngineService (movementType
/// PURCHASE_RETURN) and posts the supplier credit, in the same
/// transaction. It never modifies or deletes the original receiving
/// StockMovement rows - it only ever adds new, opposite ones.
model PurchaseReturn {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  purchaseId   String   @map("purchase_id")
  warehouseId  String   @map("warehouse_id")
  returnNumber String   @map("return_number")
  reason       String?
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "purchase_returns_business_fk")
  purchase  Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  warehouse Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     PurchaseReturnItem[]

  @@index([businessId])
  @@index([purchaseId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  purchaseReturnId String   @map("purchase_return_id")
  purchaseItemId   String   @map("purchase_item_id")
  variantId        String   @map("variant_id")
  quantity         Decimal  @db.Decimal(18, 4)
  /// The cost basis used for the SUPPLIER credit (copied from the
  /// original PurchaseItem.unitCost) - deliberately independent from
  /// whatever cost the Inventory Engine uses for the stock-side decrease.
  /// A decrease ALWAYS uses the current average cost as COGS (Phase 3
  /// costing rule, zero special-casing for returns), which may differ
  /// from the original purchase cost if other movements happened since;
  /// the supplier owes back what we originally paid them, which is a
  /// separate concern from what the stock is valued at today.
  unitCost         Decimal  @map("unit_cost") @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @map("created_at")

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "purchase_return_items_business_fk")
  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([purchaseItemId])
  @@index([businessId])
  @@map("purchase_return_items")
}

/// Records money paid to a supplier against a Purchase. Deliberately NOT
/// wired to any FinancialAccount/JournalEntry - Phase 6 (Accounting
/// Engine) is out of this phase's scope entirely (per explicit
/// instruction), so this is designed as the clean, additive boundary
/// Phase 6 will read from later, not a parallel/fake accounting system.
model PurchasePayment {
  id         String                @id @default(uuid())
  businessId String                @map("business_id")
  purchaseId String                @map("purchase_id")
  supplierId String                @map("supplier_id")
  amount     Decimal               @db.Decimal(18, 4)
  method     PurchasePaymentMethod @default(CASH)
  reference  String?
  notes      String?
  paidBy     String?               @map("paid_by")
  paidAt     DateTime              @default(now()) @map("paid_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "purchase_payments_business_fk")
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([purchaseId])
  @@index([supplierId])
  @@map("purchase_payments")
}

// ============================================================================
// PHASE 5: SALES / POS
//
// Sales is a CONSUMER of the Inventory Engine, exactly like Purchasing -
// the only inventory-affecting code in this domain calls
// InventoryEngineService.applyMovement (via the shared, tx-accepting
// consumeVariant helper extracted from Phase 3's ConsumeStockUseCase - see
// engines/inventory and modules/inventory/domain/consume-variant.ts), never
// a direct stock_balances/stock_movements write.
//
// SCOPE DECISIONS (approved before implementation - see PROJECT_STATE.md
// for the full rationale of each):
//   - Held Invoices / stock reservation: OUT for v1. A Sale is created
//     already-COMPLETED in one atomic call; the POS cart lives client-side
//     until checkout. StockBalance.quantityReserved (Phase 3) remains
//     unwritten - SaleStatus is deliberately a single-value enum today so
//     a future DRAFT/HELD state can be added later (new enum value +
//     status default stays COMPLETED for every existing row) without
//     reshaping this schema.
//   - Shift/Register: IN, minimal. A Sale requires the acting user to hold
//     an OPEN Shift (enforced both in application code and by the Sale.shiftId
//     FK being non-nullable) - no cash-count/reconciliation fields, no
//     Register/Terminal/Device entities.
//   - Offline batch sync (/pos-sync/*, Device, SyncQueueItem): OUT for v1.
//     CreateSaleUseCase's idempotencyKey design is exactly what a future
//     sync layer would reuse unchanged (Phase 0 §8's own
//     hash(device_id + offline_transaction_id) scheme maps directly onto
//     it) - no parallel Sales implementation would be needed later.
//   - Bundle-type SaleItems can be sold (reuses consumeVariant's existing
//     bundle expansion) but cannot be individually returned in v1 - see
//     CreateSaleReturnUseCase.
//
// MONETARY MODEL (Sale), precisely defined per the Phase 5 review:
//   subtotal        = SUM(SaleItem.quantity * SaleItem.unitPrice)  [gross, pre-discount]
//   discountAmount  = SUM(SaleItem.discountAmount)
//   taxAmount       = SUM(SaleItem.taxAmount)
//   totalAmount     = subtotal - discountAmount + taxAmount  [the "Sale total" / "Net total" - what the customer owes for these goods]
//   paidAmount, remainingAmount, paymentStatus are NEVER stored - always
//   SUM(SalePayment.amount) / (totalAmount - paid) / derived, computed on
//   read, mirroring the SupplierTransaction-balance-by-SUM principle.
//   SalePayment.amount is the amount ACTUALLY APPLIED to the sale, never
//   more than outstanding - change-due (cash tendered minus amount owed)
//   is a cash-drawer/UI concern, not a ledger amount, and is out of scope.
//   INVARIANT: if Sale.customerId IS NULL (walk-in/cash sale, no account to
//   extend credit to), SUM(initial SalePayment.amount) MUST equal
//   totalAmount exactly at creation - no credit without an identified
//   Customer. If customerId IS SET, initial payment may be any amount from
//   0 up to totalAmount (a credit sale), collectible later via
//   POST /sales/:id/payments.
// ============================================================================

enum SaleStatus {
  COMPLETED
}

enum CustomerTransactionType {
  SALE
  SALE_RETURN
  PAYMENT
  OPENING_BALANCE
  ADJUSTMENT
}

enum SalePaymentMethod {
  CASH
  CARD
  WALLET
  OTHER
}

enum SaleReturnCondition {
  SELLABLE
  DAMAGED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Customer {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  name       String
  phone      String?
  email      String?
  address    String?
  taxNumber  String?  @map("tax_number")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "customers_business_fk")
  sales        Sale[]
  transactions CustomerTransaction[]
  warranties   Warranty[]
  points       CustomerPoints[]

  // Deliberately NO unique constraint on name/phone: unlike Supplier,
  // customer names/phones legitimately repeat in retail and there is no
  // reliable natural business key to dedupe on - the operator resolves
  // duplicates manually if it ever matters to them.
  @@index([businessId])
  @@index([phone])
  @@map("customers")
}

/// Append-only ledger - the ONLY source of truth for a customer's
/// balance, mirroring SupplierTransaction exactly (Phase 4). Balance =
/// SUM(amount), always computed on read, never stored. Sign convention:
/// positive = increases what the CUSTOMER owes the business (a SALE, or a
/// positive OPENING_BALANCE); negative = decreases it (a PAYMENT or a
/// SALE_RETURN credit).
model CustomerTransaction {
  id            String                  @id @default(uuid())
  businessId    String                  @map("business_id")
  customerId    String                  @map("customer_id")
  type          CustomerTransactionType
  amount        Decimal                 @db.Decimal(18, 4)
  referenceType String?                 @map("reference_type")
  referenceId   String?                 @map("reference_id")
  description   String?
  createdBy     String?                 @map("created_by")
  createdAt     DateTime                @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "customer_transactions_business_fk")
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([customerId])
  @@index([referenceType, referenceId])
  @@map("customer_transactions")
}

/// Minimal Shift/Register concept (Phase 5 scope decision: IN, but not a
/// cash-management module - no opening/closing cash-count fields). A Sale
/// requires the acting user to hold an OPEN Shift. Exactly one OPEN shift
/// per (businessId, openedBy) is enforced by a partial unique index
/// (see the RLS/constraints migration - Prisma's schema DSL cannot
/// express a WHERE-qualified unique index) - the database provides this
/// guarantee, not just an application pre-check.
model Shift {
  id          String      @id @default(uuid())
  businessId  String      @map("business_id")
  branchId    String      @map("branch_id")
  warehouseId String      @map("warehouse_id")
  openedBy    String      @map("opened_by")
  openedAt    DateTime    @default(now()) @map("opened_at")
  closedBy    String?     @map("closed_by")
  closedAt    DateTime?   @map("closed_at")
  status      ShiftStatus @default(OPEN)

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "shifts_business_fk")
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sales     Sale[]

  @@index([businessId])
  @@index([openedBy])
  @@index([status])
  @@map("shifts")
}

model Sale {
  id             String     @id @default(uuid())
  businessId     String     @map("business_id")
  branchId       String     @map("branch_id")
  warehouseId    String     @map("warehouse_id")
  customerId     String?    @map("customer_id")
  shiftId        String     @map("shift_id")
  saleNumber     String     @map("sale_number")
  status         SaleStatus @default(COMPLETED)
  /// Tenant-scoped idempotency key - the Sale itself is the retryable
  /// business unit (Phase 5 rule #8). NULL never conflicts with another
  /// NULL (same opt-in-per-request pattern as PurchaseReceipt).
  idempotencyKey String?    @map("idempotency_key")
  subtotal       Decimal    @default(0) @db.Decimal(18, 4)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount      Decimal    @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount    Decimal    @default(0) @map("total_amount") @db.Decimal(18, 4)
  notes          String?
  createdBy      String?    @map("created_by")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "sales_business_fk")
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shift     Shift         @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  items     SaleItem[]
  payments  SalePayment[]
  returns   SaleReturn[]

  @@unique([businessId, saleNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([customerId])
  @@index([shiftId])
  @@index([status])
  /// Phase 7 (Reporting): every date-ranged sales report and dashboard
  /// KPI filters on (business_id, created_at) - previously unindexed.
  @@index([businessId, createdAt])
  /// Phase 7 (Reporting): sales-by-employee/user grouping.
  @@index([businessId, createdBy])
  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  saleId           String   @map("sale_id")
  variantId        String   @map("variant_id")
  quantity         Decimal  @db.Decimal(18, 4)
  /// Historical PRICE snapshot at the moment of sale - never
  /// recalculated from ProductPrice/PriceList after completion (Phase 5
  /// rule #6), exactly mirroring PurchaseItem.unitCost's non-retroactivity.
  unitPrice        Decimal  @map("unit_price") @db.Decimal(18, 4)
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount        Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal        Decimal  @default(0) @map("line_total") @db.Decimal(18, 4)
  /// Cumulative quantity returned across ALL SaleReturns for this line -
  /// the document-level invariant guarded by CHECK(quantity_returned <=
  /// quantity) plus the Sale-row lock during returns, exactly mirroring
  /// PurchaseItem.quantityReturned.
  quantityReturned Decimal  @default(0) @map("quantity_returned") @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @map("created_at")

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "sale_items_business_fk")
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems SaleReturnItem[]
  warranties  Warranty[]

  @@unique([saleId, variantId])
  @@index([businessId])
  @@index([saleId])
  @@index([variantId])
  /// Phase 7 (Reporting): sales-by-product and sales-by-category
  /// aggregation groups SaleItems by variant within a business.
  @@index([businessId, variantId])
  @@map("sale_items")
}

/// A Sale's payments - both the initial tender(s) recorded atomically at
/// sale completion AND later installments against a credit sale (via
/// POST /sales/:id/payments). idempotencyKey from day one (Phase 5 rule
/// #8/#9 - must not reproduce Purchasing's PurchaseReturn gap, Known
/// Issue #23).
model SalePayment {
  id             String            @id @default(uuid())
  businessId     String            @map("business_id")
  saleId         String            @map("sale_id")
  amount         Decimal           @db.Decimal(18, 4)
  method         SalePaymentMethod @default(CASH)
  reference      String?
  idempotencyKey String?           @map("idempotency_key")
  receivedBy     String?           @map("received_by")
  receivedAt     DateTime          @default(now()) @map("received_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "sale_payments_business_fk")
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([saleId])
  /// Phase 7 (Reporting): payment-method breakdown filters by period
  /// before grouping on method.
  @@index([businessId, receivedAt])
  @@map("sale_payments")
}

/// A sale return is a single-step atomic action (not a draft/confirm
/// workflow), exactly mirroring PurchaseReturn - but WITH idempotencyKey
/// from day one, correcting Known Issue #23 rather than reproducing it.
model SaleReturn {
  id             String   @id @default(uuid())
  businessId     String   @map("business_id")
  saleId         String   @map("sale_id")
  warehouseId    String   @map("warehouse_id")
  returnNumber   String   @map("return_number")
  idempotencyKey String?  @map("idempotency_key")
  reason         String?
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "sale_returns_business_fk")
  sale      Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     SaleReturnItem[]

  @@unique([businessId, returnNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String              @id @default(uuid())
  businessId   String              @map("business_id")
  saleReturnId String              @map("sale_return_id")
  saleItemId   String              @map("sale_item_id")
  variantId    String              @map("variant_id")
  quantity     Decimal             @db.Decimal(18, 4)
  /// Snapshot of the original SaleItem.unitPrice - the basis for the
  /// customer credit, independent of whatever cost the Inventory Engine
  /// applies to the stock-side movement (same separation of concerns as
  /// PurchaseReturnItem.unitCost).
  unitPrice    Decimal             @map("unit_price") @db.Decimal(18, 4)
  /// SELLABLE -> the returned goods go back into sellable stock (a real
  /// SALES_RETURN increase movement, costed at the ORIGINAL sale's
  /// unit_cost_at_movement - carried over, never fabricated, exactly
  /// like a Stock Transfer receive). DAMAGED -> the same SALES_RETURN
  /// increase is posted (the goods DID physically come back), IMMEDIATELY
  /// followed by a DAMAGE decrease of the same quantity (at whatever the
  /// engine's current average cost is at that instant, per the standard
  /// decrease-costing rule - zero special-casing) - net stock effect
  /// zero, but both real events stay visible in the ledger rather than
  /// being silently netted away. The customer credit is posted the same
  /// way regardless of condition - a damaged return is the store's
  /// inventory loss to absorb, not the customer's.
  condition    SaleReturnCondition @default(SELLABLE)
  createdAt    DateTime            @default(now()) @map("created_at")

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "sale_return_items_business_fk")
  saleReturn SaleReturn     @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([saleReturnId])
  @@index([saleItemId])
  @@index([businessId])
  @@map("sale_return_items")
}

// ============================================================================
// Phase 6: Accounting (Chart of Accounts, General Ledger, Fiscal Periods)
// ============================================================================
// AccountingEngine.postEntry(tx, ...) is the ONLY way an automatic journal
// entry is created - never a direct insert from Sales/Purchasing/Inventory
// code. Every automatic posting happens inside the SAME DB transaction as
// the business event it represents (Sale, PurchaseReceipt, SaleReturn,
// PurchaseReturn, SalePayment, PurchasePayment, or a standalone inventory
// Adjustment), so the journal entry and the business fact it represents
// commit or roll back together - never one without the other. Automatic
// postings go straight to POSTED (Phase 6 scope decision: no manual-review
// workflow for routine business events); DRAFT is reserved for a future
// manual/adjusting-entry capability that is NOT built in Phase 6 (no HTTP
// path ever creates a DRAFT entry today - see PROJECT_STATE.md).
//
// No branch-level GL hierarchy (Phase 6 scope decision): Account has no
// branchId. TRANSFER_IN/TRANSFER_OUT stock movements between branches of
// the same business therefore have NO accounting posting at all - the same
// business-scoped Inventory account nets to zero either way.
//
// No historical backfill (Phase 6 scope decision): Phase 6 posts only for
// events created from its own activation onward. Phases 1-5's pre-existing
// Sales/Purchases/Payments/Adjustments never get retroactive journal
// entries - see the one-time bootstrap seed (COA + mapping rules + a single
// open-ended FiscalPeriod per existing business) in prisma/seed.ts, which
// is infrastructure setup, not a reinterpretation of historical data.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

/// The fixed set of accounting "roles" AccountingMappingRule resolves to a
/// real Account. One row per (businessId, key) - see
/// modules/accounting/domain/resolve-mapped-account.ts. Deliberately NOT a
/// per-transaction-type mapping (e.g. no separate "Sale Cash" vs "Sale
/// Credit" keys) - the caller (CreateSaleUseCase etc.) already knows the
/// exact business shape (which payment methods, how much credit) and
/// assembles the journal lines itself from these account-role primitives,
/// keeping the mapping table small and the posting logic auditable in the
/// use-case that owns the business fact - not hidden inside a generic
/// rules-interpreter.
enum AccountingMappingKey {
  SALES_REVENUE
  COGS
  INVENTORY_ASSET
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  TAX_PAYABLE
  INVENTORY_SHRINKAGE
  INVENTORY_GAIN
  INTERNAL_CONSUMPTION_EXPENSE
  TENDER_CASH
  TENDER_CARD
  TENDER_WALLET
  TENDER_BANK_TRANSFER
  TENDER_CHEQUE
  TENDER_OTHER
}

/// Chart of Accounts - business-scoped only (Phase 6 scope decision: no
/// branch-level GL hierarchy). System accounts (isSystemAccount=true) are
/// seeded once per business (RegisterBusinessUseCase for new businesses,
/// the one-time bootstrap in prisma/seed.ts for pre-existing ones) and are
/// referenced by AccountingMappingRule; they can be renamed or deactivated
/// but never deleted - the same "protected default, no hard delete"
/// posture every other reference entity in this codebase already uses
/// (Customer.isActive, ProductVariant.status), enforced in the application
/// layer, not a DB constraint.
model Account {
  id              String        @id @default(uuid())
  businessId      String        @map("business_id")
  code            String
  name            String
  type            AccountType
  normalBalance   NormalBalance @map("normal_balance")
  parentAccountId String?       @map("parent_account_id")
  isSystemAccount Boolean       @default(false) @map("is_system_account")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  createdBy       String?       @map("created_by")
  updatedBy       String?       @map("updated_by")

  business      Business                @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "accounts_business_fk")
  parentAccount Account?                @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  childAccounts Account[]               @relation("AccountHierarchy")
  mappingRules  AccountingMappingRule[]
  journalLines  JournalEntryLine[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([parentAccountId])
  @@map("accounts")
}

/// Entries are linked to the fiscal period covering their entryDate (Phase
/// 0 §6.4). A CLOSED period rejects new entries dated within it, unless the
/// actor holds accounting.reopen_period. Every existing business gets one
/// open-ended bootstrap period at Phase 6 activation (see prisma/seed.ts) -
/// the Accountant can close it at any cutoff and open the next one via the
/// period endpoints, exactly like normal ongoing period management.
model FiscalPeriod {
  id         String             @id @default(uuid())
  businessId String             @map("business_id")
  name       String
  startDate  DateTime           @map("start_date")
  endDate    DateTime           @map("end_date")
  status     FiscalPeriodStatus @default(OPEN)
  closedBy   String?            @map("closed_by")
  closedAt   DateTime?          @map("closed_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  createdBy  String?            @map("created_by")

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "fiscal_periods_business_fk")
  journalEntries JournalEntry[]

  @@index([businessId])
  @@map("fiscal_periods")
}

model AccountingMappingRule {
  id         String               @id @default(uuid())
  businessId String               @map("business_id")
  key        AccountingMappingKey
  accountId  String               @map("account_id")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "accounting_mapping_rules_business_fk")
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([businessId, key])
  @@index([businessId])
  @@map("accounting_mapping_rules")
}

/// The immutable business-event header (Phase 0 §6.2: Draft -> Posted ->
/// (Reversed); no UPDATE on a Posted entry - corrections are new reversal
/// entries only, never edits). sourceType/sourceId is the exact same
/// polymorphic-reference pattern StockMovement.referenceType/referenceId
/// already uses, and (businessId, sourceType, sourceId) is the final
/// DB-level duplicate-posting backstop (Phase 0 §10: idempotency must not
/// rely on an application pre-check alone). (businessId, reversalOfId) is
/// a second, nullable-opt-in unique constraint (same pattern as every
/// idempotencyKey column in this schema) guaranteeing at most ONE reversal
/// per original entry, DB-enforced - not just an application check.
model JournalEntry {
  id             String             @id @default(uuid())
  businessId     String             @map("business_id")
  fiscalPeriodId String             @map("fiscal_period_id")
  entryNumber    String             @map("entry_number")
  entryDate      DateTime           @map("entry_date")
  status         JournalEntryStatus @default(POSTED)
  sourceType     String             @map("source_type")
  sourceId       String             @map("source_id")
  reversalOfId   String?            @map("reversal_of_id")
  description    String?
  postedBy       String?            @map("posted_by")
  postedAt       DateTime?          @map("posted_at")
  createdBy      String?            @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "journal_entries_business_fk")
  fiscalPeriod FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  reversalOf   JournalEntry?      @relation("JournalEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   JournalEntry[]     @relation("JournalEntryReversal")
  lines        JournalEntryLine[]

  @@unique([businessId, sourceType, sourceId])
  @@unique([businessId, entryNumber])
  @@unique([businessId, reversalOfId])
  @@index([businessId])
  @@index([fiscalPeriodId])
  /// Phase 7 (Reporting): the P&L, Balance Sheet and General Ledger
  /// reports are all bounded on (business_id, entry_date) - previously
  /// unindexed.
  @@index([businessId, entryDate])
  @@map("journal_entries")
}

/// Append-only at the DB-privilege level (erp_app: SELECT+INSERT only, no
/// UPDATE, no DELETE - see accounting_app_role_grants). A DEFERRED
/// constraint trigger (accounting_schema migration) re-verifies
/// SUM(debit)=SUM(credit) per journal_entry_id at transaction-commit time
/// as the second line of defense behind AccountingEngine.postEntry's own
/// pre-insert application-layer check (Phase 0 §6.1).
model JournalEntryLine {
  id             String   @id @default(uuid())
  businessId     String   @map("business_id")
  journalEntryId String   @map("journal_entry_id")
  accountId      String   @map("account_id")
  debit          Decimal  @default(0) @db.Decimal(18, 4)
  credit         Decimal  @default(0) @db.Decimal(18, 4)
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "journal_entry_lines_business_fk")
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// ============================================================================
// Phase 8A: Warranty (record-keeping only)
// ============================================================================
// Deliberately inert with respect to every other engine: registering a
// warranty or a claim creates NO StockMovement, NO JournalEntry, NO
// SalePayment and NO SaleReturn. Warranty is a record of an obligation,
// not a financial or inventory event - any replacement/refund workflow is
// explicitly deferred to a later phase (approved Phase 8 scope decision
// 14). This is why the module injects neither InventoryEngineService nor
// AccountingEngineService: it structurally cannot mutate either.
//
// Scope is SERIAL-TRACKED ITEMS ONLY (approved decision 13, and what
// Phase 0 §4.7's `Warranty ──> SerialNumber / SaleItem / Customer`
// anchors on): a warranty always identifies exactly one physical unit.
// A SaleItem for a non-serialized product cannot be warranted.

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
  VOID
}

enum WarrantyClaimStatus {
  OPEN
  RESOLVED
  REJECTED
}

/// One warranty = one physical serial unit sold on one SaleItem.
///
/// `durationDays` is SNAPSHOTTED at registration (from the optional
/// per-registration override, else the business default in
/// `Setting['warranty.default_duration_days']`), and `endDate` is derived
/// from it once. Changing the business default afterwards therefore
/// affects only FUTURE registrations - an issued warranty is never
/// recomputed from current configuration, the same historical-integrity
/// rule Sale/SaleItem and StockMovement already follow.
model Warranty {
  id             String         @id @default(uuid())
  businessId     String         @map("business_id")
  saleItemId     String         @map("sale_item_id")
  serialNumberId String         @map("serial_number_id")
  /// Denormalised from the Sale at registration so a warranty lookup
  /// never has to join back through Sale - and so it stays correct even
  /// if the Sale's customer association were ever to change (it cannot
  /// today: a Sale is immutable).
  customerId     String?        @map("customer_id")
  /// Always the SALE's own createdAt - never the registration time, and
  /// never client-supplied. A warranty period starts when the customer
  /// took the goods, not when someone got round to registering it.
  startDate      DateTime       @map("start_date")
  endDate        DateTime       @map("end_date")
  durationDays   Int            @map("duration_days")
  status         WarrantyStatus @default(ACTIVE)
  notes          String?
  createdBy      String?        @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "warranties_business_fk")
  saleItem     SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  serialNumber SerialNumber    @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  claims       WarrantyClaim[]

  /// One warranty per (sale line, serial unit) - the DB-level guarantee
  /// that a retried registration request cannot issue a duplicate
  /// warranty for the same physical unit, rather than relying on an
  /// application pre-check alone.
  @@unique([businessId, saleItemId, serialNumberId])
  @@index([businessId])
  @@index([saleItemId])
  @@index([serialNumberId])
  @@index([customerId])
  @@index([status])
  @@map("warranties")
}

/// Append-only at INSERT: a claim row is never deleted, and the only
/// mutation permitted is the OPEN -> RESOLVED|REJECTED transition, which
/// records `resolvedAt`/`resolvedBy`/`resolution` alongside the status so
/// the transition stays auditable rather than silently overwriting
/// history (approved decision 15). `claimedAt` and `description` are
/// never rewritten.
model WarrantyClaim {
  id          String              @id @default(uuid())
  businessId  String              @map("business_id")
  warrantyId  String              @map("warranty_id")
  claimedAt   DateTime            @default(now()) @map("claimed_at")
  description String
  status      WarrantyClaimStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?           @map("resolved_at")
  resolvedBy  String?             @map("resolved_by")
  createdBy   String?             @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "warranty_claims_business_fk")
  warranty Warranty @relation(fields: [warrantyId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([warrantyId])
  @@index([status])
  @@map("warranty_claims")
}

// ---------------------------------------------------------------------------
// Phase 8B - Loyalty Ledger
// ---------------------------------------------------------------------------

/// Why a point event has a type at all: a balance of "150" is useless on
/// its own - the business needs to see WHY. EARN/REDEEM/RETURN_CLAWBACK
/// are all machine-generated from a Sale or SaleReturn; ADJUSTMENT is the
/// only human-entered one, and it is the only one that may be signed
/// either way.
enum CustomerPointsType {
  EARN
  REDEEM
  RETURN_CLAWBACK
  ADJUSTMENT
}

/// APPEND-ONLY loyalty ledger (approved Phase 8 policy). A customer's
/// point balance is ALWAYS `SUM(points)` computed on read - there is
/// deliberately no stored, mutable balance column anywhere in this
/// schema, exactly like `CustomerTransaction`/`SupplierTransaction`
/// already work for money. `erp_app` gets SELECT+INSERT only (no UPDATE,
/// no DELETE), so append-only is a database guarantee rather than an
/// application convention.
///
/// Corrections are new compensating rows, never edits: a return's
/// clawback inserts a RETURN_CLAWBACK row and leaves the original EARN
/// row byte-for-byte intact.
///
/// `basisAmount`/`rateSnapshot` freeze the BD-3 earning calculation onto
/// the row itself, so a later change to the business's loyalty rate can
/// never alter, re-derive, or invalidate points already earned - and a
/// return's clawback can reproduce the ORIGINAL earning arithmetic
/// without consulting current configuration.
model CustomerPoints {
  id             String             @id @default(uuid())
  businessId     String             @map("business_id")
  customerId     String             @map("customer_id")
  type           CustomerPointsType
  /// Signed: positive adds to the balance, negative removes from it.
  /// Never zero (CHECK-enforced) - a zero-point event carries no
  /// information and would only pollute the ledger.
  points         Decimal            @db.Decimal(18, 4)
  /// The merchandise amount the points were computed from (BD-3:
  /// subtotal - discounts, excluding tax). Snapshot, not a live link.
  basisAmount    Decimal?           @map("basis_amount") @db.Decimal(18, 4)
  /// The points-per-currency-unit rate in force at the moment of the
  /// event. Snapshot, not a live link.
  rateSnapshot   Decimal?           @map("rate_snapshot") @db.Decimal(18, 6)
  referenceType  String?            @map("reference_type")
  referenceId    String?            @map("reference_id")
  description    String?
  /// Present only on human-entered ADJUSTMENT rows; machine-generated
  /// events inherit the idempotency of the Sale/SaleReturn that produced
  /// them.
  idempotencyKey String?            @map("idempotency_key")
  createdBy      String?            @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, map: "customer_points_business_fk")
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([businessId, customerId])
  @@index([referenceType, referenceId])
  @@index([type])
  @@map("customer_points")
}

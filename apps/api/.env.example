NODE_ENV=development
PORT=3000

# Migration/owner connection. Used ONLY by `prisma migrate` and the seed
# script. Never used by the running API process.
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_dev?schema=public

# Runtime connection used by the NestJS API's Prisma client. MUST point at
# the restricted `erp_app` role (created by migration
# 20260828121600_lockdown_app_role), which has NOSUPERUSER/NOBYPASSRLS so
# Row-Level Security tenant-isolation policies actually apply. Never point
# this at a superuser - that would silently bypass every RLS policy.
RUNTIME_DATABASE_URL=postgresql://erp_app:erp_app_dev_only_change_in_prod@localhost:5432/erp_dev?schema=public

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=30d

# Comma-separated. The POS dev server is 5173/5174; the ERP web app is 5175.
CORS_ORIGIN=http://localhost:5173,http://localhost:5175
